# ---------- App ----------
NODE_ENV=development
PORT=8000
# Comma separated list of browser origins allowed to call the API directly
CORS_ORIGIN=http://localhost:3000
# Set to true when served over HTTPS (defaults to true in production)
COOKIE_SECURE=false

# ---------- Database ----------
# MySQL 5.5+ / MariaDB. Tables are created/migrated automatically on startup.
# The password is used exactly as written (no URL-encoding needed).
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=anura_dashboard
# Max DB connections; lower it if your host limits connections per user
DB_POOL_SIZE=5

# ---------- JWT (use long random strings) ----------
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_PASS_RESET_SECRET=

# ---------- Root user (created on first boot only) ----------
ROOT_NAME=Root
ROOT_EMAIL=
ROOT_PASSWORD=

# ---------- Anura Reporting API ----------
# Token from https://dashboard.anura.io/api
ANURA_API_TOKEN=
# Default instance shown in the dashboard
ANURA_INSTANCE_ID=
ANURA_API_URL=https://api.anura.io/v1
# auto | json | form  (auto detects which body encoding Anura accepts)
ANURA_BODY_FORMAT=auto
# How long live responses are cached server side
ANURA_CACHE_TTL_SECONDS=15

# ---------- Email (optional, needed for "forgot password") ----------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
